[Unit]
Description=Gauntlet Ecology read-only API and LAN web UI
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/gauntlet-ecology
# Credentials (DATABASE_URL) come from the 0600 env file, not this unit.
EnvironmentFile=/root/gauntlet-ecology/.env
ExecStart=/root/gauntlet-ecology/.venv/bin/uvicorn api.main:app --host 192.168.8.150 --port 8001
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
